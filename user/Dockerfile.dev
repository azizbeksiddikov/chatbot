# Build context: project root. Container layout mirrors repo.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY user/backend/ /app/user/backend/
COPY user/frontend/ /app/user/frontend/

WORKDIR /app/user/backend
EXPOSE 5000
CMD ["python", "-c", "from app import app; app.run(host='0.0.0.0', port=5000, debug=True, use_reloader=True)"]
