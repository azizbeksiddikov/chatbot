# Copy this file to .env.dev for local development
# Copy this file to .env.prod for production (fill in all real values)
# See docs/ENV_KEYS.md for how to get each key

# === Database ===
# Dev default works with docker-compose out of the box
# Prod: use a managed DB (e.g. Supabase, Railway, Neon)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/chatbot

# === Auth (BetterAuth) ===
# BETTER_AUTH_SECRET: any random 32+ char string (openssl rand -base64 32)
# Dev: http://localhost:3000 | Prod: your real domain
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — needed for login to work (see docs/ENV_KEYS.md)
# Dev: leave empty to disable login; Prod: required
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === LLM APIs ===
# At least GEMINI_API_KEY is required for the chatbot to respond
# Fallback providers (GROQ, CEREBRAS, MISTRAL) are optional
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# === Embeddings ===
EMBEDDING_DIMENSIONS=768

# === File Storage - Cloudflare R2 ===
# Required for file uploads; leave empty to disable upload feature
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chatbot-files
R2_PUBLIC_URL=

# === App URLs ===
# Dev defaults work as-is; Prod: replace with real domains
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# === Next.js public (exposed to browser) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
